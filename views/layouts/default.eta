  <%layout(`base/${it.view?.base||'default'}`)%>
<div id="main">
  <%{vue%>
    <organisms-header />
    <organisms-overlay-contact />
    <OrganismsOverlayFormPerson />
    <OrganismsOverlayFormCompany />
  <% vue} %>
  <%~ it.body%>
  <% if(it?.page?.name!='policy'){%>
  <%{vue%>
    <molecules-cookies />
    <molecules-cookies-dialog />
  <% vue} %>
  <% }%>
  <%{vue%>
    <molecules-btn-whatsapp />
    <organisms-footer/>
  <% vue} %>
</div>
